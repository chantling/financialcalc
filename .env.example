# Cache Configuration
CACHE_DIR=./cache
CACHE_ENABLED=true

# Yahoo Finance API
YFINANCE_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=2

# Alpha Vantage API (optional fallback for missing market cap / shares data)
# Free tier: 25 requests/day. Only used when Yahoo Finance data is missing.
ALPHA_VANTAGE_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=INFO

# IV Tracker path
IV_TRACKER_DB_PATH=C:/Users/John/Documents/#Python#/#Financial#/IV-Tracker/data/iv_tracker.db